# Proofline Environment Variables

# Database
DATABASE_URL="postgresql://proofline:password@localhost:5432/proofline_dev?schema=public"

# NextAuth / GitHub OAuth sign-in
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
NEXTAUTH_SECRET=
NEXTAUTH_URL="http://localhost:3000"

# Public app configuration
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:3000"
NEXT_PUBLIC_GITHUB_APP_SLUG="proofline-mahadeva"

# GitHub App webhook (separate from OAuth sign-in)
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# Object Storage (MinIO local)
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_BUCKET_NAME="proofline-evidence"

# Worker Toggles
WORKERS_ENABLED=true
GITHUB_INTEGRATION_ENABLED=true
